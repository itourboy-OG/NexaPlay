<Window x:Class="NexaPlay.PlayerProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Player Profile — NexaPlay" Width="640" Height="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#090C14" Foreground="White">
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="PLAYER PROFILE" FontSize="27" FontWeight="Black"/>
            <TextBlock Text="Make NexaPlay yours. Your profile stays private on this PC." Foreground="#8793AA" Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#111725" BorderBrush="#303A53" BorderThickness="1" CornerRadius="4" Padding="24" Margin="0,24,0,24">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="112" Height="112" CornerRadius="4" Background="#2A2251" BorderBrush="#7258DA" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="InitialsText" Text="P" FontSize="40" FontWeight="Black" Foreground="#D5CDFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="AvatarImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource GhostButton}" Content="Choose picture" Margin="0,14,0,0" Padding="13,8" Click="ChoosePicture_Click"/>
                    <Button x:Name="RemovePictureButton" Style="{StaticResource GhostButton}" Content="Remove" Margin="0,8,0,0" Padding="13,7" Click="RemovePicture_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="24,2,0,0">
                    <TextBlock Text="USERNAME" Foreground="#45DDF2" FontSize="10" FontWeight="Bold"/>
                    <TextBox x:Name="UsernameBox" Margin="0,9,0,0" MaxLength="24" TextChanged="UsernameBox_TextChanged"/>
                    <TextBlock Text="This name appears only in your NexaPlay sidebar. The picture is optional and is copied into your private local app data." TextWrapping="Wrap" Foreground="#7E8AA2" FontSize="11" LineHeight="17" Margin="0,12,0,0"/>
                    <Border Background="#17132A" BorderBrush="#3C306A" BorderThickness="1" CornerRadius="3" Padding="14" Margin="0,22,0,0">
                        <StackPanel><TextBlock Text="READY UP · GAME ON" Foreground="#BBAEFF" FontWeight="Bold" FontSize="10"/><TextBlock Text="Your library, downloads, favorites, and ratings stay connected to this Windows account." TextWrapping="Wrap" Foreground="#9AA4B8" FontSize="10" Margin="0,6,0,0"/></StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click"/><Button Style="{StaticResource PrimaryButton}" Content="Save profile" Margin="10,0,0,0" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
