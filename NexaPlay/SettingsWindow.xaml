<Window x:Class="NexaPlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexaPlay Settings" Width="900" Height="720" MinWidth="780" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="SETTINGS" FontSize="28" FontWeight="Black"/><TextBlock Text="Your library, catalog connection, storage, and NexaPlay tools." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,0,22">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="APP TOOLS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource GhostButton}" Height="112" Padding="16" HorizontalContentAlignment="Left" Click="SyncCatalog_Click"><StackPanel><TextBlock Text="↻  SYNC CATALOG" FontWeight="Black" FontSize="12"/><TextBlock Text="Get newly published games and metadata now." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Button>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="112" Padding="16" Margin="10,0,0,0" HorizontalContentAlignment="Left" Click="CheckForUpdates_Click"><StackPanel><TextBlock Text="↑  CHECK FOR UPDATES" FontWeight="Black" FontSize="12"/><TextBlock Text="Check for a newer NexaPlay release. Installation stays manual." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Button>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="112" Padding="16" Margin="10,0,0,0" HorizontalContentAlignment="Left" Click="GettingStarted_Click"><StackPanel><TextBlock Text="?  GETTING STARTED" FontWeight="Black" FontSize="12"/><TextBlock Text="Open the NexaPlay guide and player setup walkthrough." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Button>
                </Grid>
                <Border Height="1" Background="#293149" Margin="0,25,0,23"/>
                <TextBlock Text="GAME LIBRARY FOLDER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LibraryBox" IsReadOnly="True"/><Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Browse…" Margin="10,0,0,0" Click="Browse_Click"/></Grid>
                <TextBlock Text="Downloaded archives and extracted games stay here. The installer never includes this folder." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0"/>
                <TextBlock Text="REMOTE CATALOG URL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" Margin="0,23,0,0"/>
                <TextBox x:Name="CatalogUrlBox" Margin="0,8,0,0"/>
                <TextBlock Text="Use a trusted direct HTTPS link to nexaplay-catalog.json. Anyone controlling this URL can change download links." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/>
                <CheckBox x:Name="AutoSyncBox" Content="Automatically refresh the catalog while NexaPlay is open" Foreground="White" Margin="0,11,0,0"/>
                <CheckBox x:Name="KeepArchivesBox" Content="Keep ZIP/RAR archives after a successful install" Foreground="White" Margin="0,18,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2">
            <Button Style="{StaticResource GhostButton}" Content="Open local data folder" HorizontalAlignment="Left" Click="OpenData_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click"/><Button Style="{StaticResource PrimaryButton}" Content="Save settings" Margin="10,0,0,0" Click="Save_Click"/></StackPanel>
        </Grid>
    </Grid>
</Window>
