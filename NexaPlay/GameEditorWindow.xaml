<Window x:Class="NexaPlay.GameEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Editor — NexaPlay" Width="1080" Height="820" MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="ADD A GAME" FontSize="28" FontWeight="Black"/><TextBlock Text="Give NexaPlay a title and your download links. It will build the rest of the page for you." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#1C1832" CornerRadius="4" Padding="13,8"><TextBlock Text="NEXAPLAY OWNER 1.11.2  •  AUTO METADATA" Foreground="#C9BAFF" FontSize="10" FontWeight="Bold"/></Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,18">
            <StackPanel Margin="0,0,12,0">
                <Border Background="#121827" BorderBrush="#44377C" BorderThickness="1" CornerRadius="15" Padding="22">
                    <StackPanel>
                        <TextBlock Text="1  FIND THE GAME" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="11"/>
                        <TextBlock Text="Type the normal game name—NexaPlay searches Steam and finds the App ID automatically." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,14"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="205"/></Grid.ColumnDefinitions><TextBox x:Name="TitleBox" FontSize="17" Padding="14,11" ToolTip="Game title, for example Forza Horizon 6"/><Button Grid.Column="1" x:Name="AutoFillButton" Style="{StaticResource PrimaryButton}" Content="✦  AUTO-FILL GAME" Margin="12,0,0,0" Click="AutoFill_Click"/></Grid>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Steam App ID" Foreground="#7F8AA4" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="SteamIdBox" Grid.Column="1" ToolTip="Optional override when Steam chooses the wrong match"/><TextBlock Grid.Column="2" Text="Optional override only—leave it blank for automatic matching." Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
                    </StackPanel>
                </Border>

                <Border Background="#111622" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="15" Padding="22" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="2  DOWNLOAD LINKS" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="11"/>
                        <TextBlock Text="Only the full game link is required. Empty Update, Online Fix, and custom-package links disappear from the public game page." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,14"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="Full game *" VerticalAlignment="Center"/><TextBox x:Name="DownloadBox" Grid.Column="1" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Text="Update" VerticalAlignment="Center"/><TextBox x:Name="UpdateUrlBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Text="Online Fix" VerticalAlignment="Center"/><TextBox x:Name="OnlineFixUrlBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Text="Custom name" VerticalAlignment="Center"/><TextBox x:Name="CustomPackageNameBox" Grid.Row="3" Grid.Column="1" Margin="0,4" ToolTip="Example: English Language Pack"/>
                            <TextBlock Grid.Row="4" Text="Custom URL" VerticalAlignment="Center"/><TextBox x:Name="CustomPackageUrlBox" Grid.Row="4" Grid.Column="1" Margin="0,4"/>
                        </Grid>
                        <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FILE SIZES &amp; LINK HEALTH" Foreground="#8994AC" FontWeight="Bold" FontSize="10"/><TextBlock Text="Check links before publishing. Expired links such as 410 Gone will be identified by package." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Check links" Padding="13,8" Click="CheckLinks_Click"/><Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Detect sizes" Padding="13,8" Margin="8,0,0,0" Click="DetectSizes_Click"/></Grid>
                        <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Full game" Foreground="#7F8AA4" FontSize="9"/><TextBox x:Name="SizeBox" Margin="0,5,0,0" ToolTip="Example: 167 GB"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Update" Foreground="#7F8AA4" FontSize="9"/><TextBox x:Name="UpdateSizeBox" Margin="0,5,0,0" ToolTip="Example: 4.2 GB"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Online Fix" Foreground="#7F8AA4" FontSize="9"/><TextBox x:Name="OnlineFixSizeBox" Margin="0,5,0,0" ToolTip="Example: 850 MB"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Custom" Foreground="#7F8AA4" FontSize="9"/><TextBox x:Name="CustomPackageSizeBox" Margin="0,5,0,0" ToolTip="Example: 2 GB"/></StackPanel></Grid>
                    </StackPanel>
                </Border>

                <Border Background="#111622" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="15" Padding="22" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="AUTO-FILLED GAME PAGE" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="11"/>
                        <TextBlock Text="You can correct these fields, but normally Auto-Fill handles them." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,14"/>
                        <TextBlock Text="Description" Foreground="#8994AC" FontSize="11"/><TextBox x:Name="DescriptionBox" Height="92" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,10"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0"><TextBlock Text="Developer" Foreground="#8994AC" FontSize="11"/><TextBox x:Name="DeveloperBox" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Publisher" Foreground="#8994AC" FontSize="11"/><TextBox x:Name="PublisherBox" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Release date" Foreground="#8994AC" FontSize="11"/><TextBox x:Name="ReleaseBox" Margin="0,6,0,0"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0"><TextBlock Text="Genres" Foreground="#8994AC" FontSize="11"/><TextBox x:Name="GenresBox" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Tags" Foreground="#8994AC" FontSize="11"/><TextBox x:Name="TagsBox" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Catalog version" Foreground="#8994AC" FontSize="11"/><TextBox x:Name="VersionBox" Margin="0,6,0,0"/></StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,14,0,0"><CheckBox x:Name="MultiplayerBox" Content="Multiplayer / online play" Foreground="White"/><CheckBox x:Name="FeaturedBox" Content="Feature in library banner" Foreground="White" Margin="24,0,0,0"/></WrapPanel>
                        <Border Background="#0D121E" BorderBrush="#313A52" BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,18,0,0">
                            <StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="GAME ARTWORK" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="11"/><TextBlock Text="Use official Steam images automatically, or paste your own public image URLs below." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel><Button x:Name="OfficialArtworkButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Get official Steam artwork" Padding="13,8" Click="FetchOfficialArtwork_Click"/><Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Try SteamGridDB" Padding="13,8" Margin="8,0,0,0" Click="FetchArtwork_Click"/></Grid>
                                <Grid Height="175" Margin="0,14,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#171D2B" BorderBrush="#364057" BorderThickness="1" CornerRadius="3" ClipToBounds="True"><Image Source="{Binding Text, ElementName=CoverBox}" Stretch="Uniform"/></Border><Border Grid.Column="1" Background="#171D2B" BorderBrush="#364057" BorderThickness="1" CornerRadius="3" ClipToBounds="True" Margin="10,0,0,0"><Image Source="{Binding Text, ElementName=HeroBox}" Stretch="Uniform"/></Border></Grid>
                                <TextBlock Text="Cover image URL" Foreground="#8994AC" FontSize="10"/><TextBox x:Name="CoverBox" Margin="0,5,0,9"/>
                                <TextBlock Text="Background / hero image URL" Foreground="#8994AC" FontSize="10"/><TextBox x:Name="HeroBox" Margin="0,5,0,9"/>
                                <TextBlock Text="Screenshot URLs — one per line" Foreground="#8994AC" FontSize="10"/><TextBox x:Name="ScreenshotsBox" Height="82" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,5,0,9"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="Trailer URL" Foreground="#8994AC" FontSize="10"/><TextBox x:Name="TrailerBox" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Gameplay URL" Foreground="#8994AC" FontSize="10"/><TextBox x:Name="GameplayBox" Margin="0,5,0,0"/></StackPanel></Grid>
                                <TextBox x:Name="SgdbIdBox" Visibility="Collapsed" IsReadOnly="True"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Expander Header="SYSTEM REQUIREMENTS  •  filled automatically" Foreground="White" Background="#111622" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="18" Margin="0,14,0,0">
                    <StackPanel Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Minimum" Foreground="#8994AC"/><TextBox x:Name="MinimumBox" Height="125" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Recommended" Foreground="#8994AC"/><TextBox x:Name="RecommendedBox" Height="125" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"/></StackPanel>
                    </Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="MinRamBox" ToolTip="Minimum RAM in GB"/><TextBox x:Name="StorageBox" Grid.Column="1" Margin="10,0,0,0" ToolTip="Required storage in GB"/></Grid></StackPanel>
                </Expander>

                <Expander Header="GUIDE &amp; SUPPORT  •  safe defaults are supplied" Foreground="White" Background="#111622" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="18" Margin="0,10,0,0">
                    <StackPanel Margin="0,14,0,0"><TextBlock Text="Installation guide" Foreground="#8994AC"/><TextBox x:Name="GuideBox" Height="88" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,10"/><TextBlock Text="Important notes" Foreground="#8994AC"/><TextBox x:Name="NotesBox" Height="88" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBox x:Name="ReportUrlBox" ToolTip="Optional report form URL"/><TextBox x:Name="SupportEmailBox" Grid.Column="1" Margin="10,0,0,0" ToolTip="Optional support email"/></Grid></StackPanel>
                </Expander>

                <Expander Header="ADVANCED OPTIONS  •  passwords, checksums, local launch details" Foreground="White" Background="#111622" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="18" Margin="0,10,0,0">
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="Archive integrity &amp; passwords (optional)" Foreground="{StaticResource CyanBrush}" FontWeight="Bold"/>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="Full game" VerticalAlignment="Center"/><TextBox x:Name="ShaBox" Grid.Column="1" Margin="0,4" ToolTip="SHA-256 checksum"/><TextBox x:Name="PasswordBox" Grid.Column="2" Margin="10,4,0,4" ToolTip="Archive password"/>
                            <TextBlock Grid.Row="1" Text="Update" VerticalAlignment="Center"/><TextBox x:Name="UpdateShaBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/><TextBox x:Name="UpdatePasswordBox" Grid.Row="1" Grid.Column="2" Margin="10,4,0,4"/>
                            <TextBlock Grid.Row="2" Text="Online Fix" VerticalAlignment="Center"/><TextBox x:Name="OnlineFixShaBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/><TextBox x:Name="OnlineFixPasswordBox" Grid.Row="2" Grid.Column="2" Margin="10,4,0,4"/>
                            <TextBlock Grid.Row="3" Text="Custom" VerticalAlignment="Center"/><TextBox x:Name="CustomPackageShaBox" Grid.Row="3" Grid.Column="1" Margin="0,4"/><TextBox x:Name="CustomPackagePasswordBox" Grid.Row="3" Grid.Column="2" Margin="10,4,0,4"/>
                        </Grid>
                        <Separator Margin="0,16" Background="#30374B"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="ExecutableBox" ToolTip="Fallback executable"/><TextBox x:Name="FolderBox" Grid.Column="1" Margin="10,0,0,0" ToolTip="Install folder name"/><TextBox x:Name="UpdatedBox" Grid.Column="2" Margin="10,0,0,0" ToolTip="Last updated date"/></Grid>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="RatingBox" ToolTip="Rating from 0 to 5"/><TextBox x:Name="RatingCountBox" Grid.Column="1" Margin="10,0,0,0" ToolTip="Rating count"/></Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2"><TextBlock x:Name="StatusText" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="650" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click"/><Button Style="{StaticResource PrimaryButton}" Content="Save game" Margin="10,0,0,0" Click="Save_Click"/></StackPanel></Grid>
    </Grid>
</Window>
