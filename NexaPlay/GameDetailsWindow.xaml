<Window x:Class="NexaPlay.GameDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game — NexaPlay" Width="1280" Height="850" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/></Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Height="390" ClipToBounds="True">
                    <Image Source="{Binding HeroUrl}" Stretch="UniformToFill" Opacity="0.62"/>
                    <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#26090B12" Offset="0"/><GradientStop Color="#FF090B12" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                    <Grid Margin="44,36,44,32">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
                        <Border Width="190" Height="285" CornerRadius="14" BorderBrush="#7260BA" BorderThickness="1" Background="#171C2B" ClipToBounds="True" VerticalAlignment="Bottom"><Image Source="{Binding CoverUrl}" Stretch="UniformToFill"/></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="26,0,28,8">
                            <WrapPanel Margin="0,0,0,10"><Border Background="#193C44" CornerRadius="5" Padding="9,5" Margin="0,0,8,0"><TextBlock Text="{Binding MultiplayerLabel}" Foreground="#78EEFF" FontWeight="Bold" FontSize="10"/></Border><Border Background="#35255A" CornerRadius="5" Padding="9,5"><TextBlock Text="{Binding Version, StringFormat=VERSION {0}}" Foreground="#D7C8FF" FontWeight="Bold" FontSize="10"/></Border></WrapPanel>
                            <TextBlock Text="{Binding Title}" FontSize="39" FontWeight="Black" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding TagLine}" Foreground="#BAC3D7" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><TextBlock Text="{Binding Stars}" Foreground="#FFD66B" FontSize="18"/><TextBlock Text="{Binding RatingLabel}" Foreground="#DDE2ED" Margin="10,3,0,0"/><TextBlock Text="{Binding LastUpdatedLabel}" Foreground="#A5AEC2" Margin="22,3,0,0"/></StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,8">
                            <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Content="▶  PLAY WITH RUN ME!.BAT" Padding="20,14" Click="Play_Click"/>
                            <Button x:Name="DownloadJumpButton" Style="{StaticResource GhostButton}" Content="↓  DOWNLOAD OPTIONS" Padding="20,13" Margin="0,9,0,0" Click="DownloadJump_Click"/>
                            <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="FavoriteButton" Style="{StaticResource GhostButton}" Content="♡  FAVORITE" Padding="12,10" Click="Favorite_Click"/><Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="⚑  REPORT" Padding="12,10" Margin="8,0,0,0" Click="Report_Click"/></Grid>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid Margin="44,0,44,50">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,34,0">
                        <TextBlock Text="ABOUT THIS GAME" FontSize="17" FontWeight="Black"/>
                        <TextBlock Text="{Binding Description}" Foreground="#C2CADB" FontSize="14" LineHeight="22" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#111622" CornerRadius="10" Padding="15"><StackPanel><TextBlock Text="DEVELOPER" Foreground="#727E99" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding Developer}" Margin="0,6,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="#111622" CornerRadius="10" Padding="15" Margin="10,0,0,0"><StackPanel><TextBlock Text="RELEASE DATE" Foreground="#727E99" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding ReleaseDate}" Margin="0,6,0,0"/></StackPanel></Border></Grid>

                        <StackPanel x:Name="MediaSection" Margin="0,32,0,0">
                            <Grid><TextBlock Text="MEDIA" FontSize="17" FontWeight="Black"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="TrailerButton" Style="{StaticResource GhostButton}" Content="▶ Trailer" Padding="14,8" Click="Trailer_Click"/><Button x:Name="GameplayButton" Style="{StaticResource GhostButton}" Content="▶ Gameplay" Padding="14,8" Margin="8,0,0,0" Click="Gameplay_Click"/></StackPanel></Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,14,0,0"><ItemsControl x:Name="ScreenshotsList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="310" Height="174" Margin="0,0,12,8" CornerRadius="10" Background="#151A29" BorderBrush="#303851" BorderThickness="1" ClipToBounds="True"><Image Source="{Binding}" Stretch="UniformToFill"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                        </StackPanel>

                        <Border x:Name="GuideSection" Background="#111622" BorderBrush="#293149" BorderThickness="1" CornerRadius="13" Padding="20" Margin="0,30,0,0"><StackPanel><TextBlock Text="INSTALLATION GUIDE" FontSize="16" FontWeight="Black"/><TextBlock Text="{Binding InstallationGuideDisplay}" Foreground="#C0C8D8" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/></StackPanel></Border>
                        <Border x:Name="NotesSection" Background="#201A15" BorderBrush="#604727" BorderThickness="1" CornerRadius="13" Padding="20" Margin="0,12,0,0"><StackPanel><TextBlock Text="IMPORTANT NOTES" Foreground="#FFD08A" FontSize="16" FontWeight="Black"/><TextBlock Text="{Binding ImportantNotesDisplay}" Foreground="#E4CEAE" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/></StackPanel></Border>

                        <TextBlock Text="SYSTEM REQUIREMENTS" FontSize="17" FontWeight="Black" Margin="0,32,0,0"/>
                        <Grid x:Name="RequirementsGrid" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#111622" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="MINIMUM" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="10"/><TextBlock Text="{Binding MinimumRequirementsDisplay}" Foreground="#C2CADB" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="#111622" CornerRadius="12" Padding="18" Margin="12,0,0,0"><StackPanel><TextBlock Text="RECOMMENDED" Foreground="#BDAEFF" FontWeight="Bold" FontSize="10"/><TextBlock Text="{Binding RecommendedRequirementsDisplay}" Foreground="#C2CADB" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"/></StackPanel></Border></Grid>
                        <Button Style="{StaticResource GhostButton}" Content="CAN I RUN IT?  —  CHECK THIS PC" HorizontalAlignment="Left" Margin="0,14,0,0" Click="CanIRun_Click"/>
                    </StackPanel>

                    <Border x:Name="DownloadSection" Grid.Column="1" Background="#111622" BorderBrush="#343D59" BorderThickness="1" CornerRadius="16" Padding="22" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="DOWNLOAD CENTER" FontSize="19" FontWeight="Black"/>
                            <TextBlock x:Name="DownloadCenterDescription" Text="Download the full game or choose an available add-on package." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,16"/>
                            <Border Background="#181E2D" CornerRadius="10" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FULL GAME" FontWeight="Bold"/><TextBlock x:Name="GameDownloadInfo" Foreground="#909BB3" FontSize="10" Margin="0,4,0,0"/></StackPanel><Button x:Name="GameDownloadButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Download" Padding="13,8" Click="DownloadGame_Click"/></Grid></Border>
                            <Border x:Name="UpdatePackageCard" Background="#181E2D" CornerRadius="10" Padding="14" Margin="0,9,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LATEST UPDATE" FontWeight="Bold"/><TextBlock x:Name="UpdateDownloadInfo" Foreground="#909BB3" FontSize="10" Margin="0,4,0,0"/></StackPanel><Button x:Name="UpdateDownloadButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="Update" Padding="13,8" Click="DownloadUpdate_Click"/></Grid></Border>
                            <Border x:Name="OnlineFixPackageCard" Background="#181E2D" CornerRadius="10" Padding="14" Margin="0,9,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ONLINE FIX" FontWeight="Bold"/><TextBlock x:Name="FixDownloadInfo" Foreground="#909BB3" FontSize="10" Margin="0,4,0,0"/></StackPanel><Button x:Name="FixDownloadButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="Download" Padding="13,8" Click="DownloadFix_Click"/></Grid></Border>
                            <Border x:Name="ProgressPanel" Background="#0E131F" CornerRadius="10" Padding="14" Margin="0,14,0,0" Visibility="Collapsed"><StackPanel><TextBlock x:Name="ActivityText" Text="Preparing…" FontSize="11" TextWrapping="Wrap"/><ProgressBar x:Name="DownloadProgress" Margin="0,9,0,0"/><Button Style="{StaticResource GhostButton}" Content="Cancel download" Padding="10,7" Margin="0,10,0,0" Click="CancelDownload_Click"/></StackPanel></Border>
                            <Separator Margin="0,18" Background="#30374B"/>
                            <TextBlock Text="DOWNLOAD INFO" Foreground="#77839C" FontWeight="Bold" FontSize="10"/>
                            <TextBlock x:Name="DownloadInfoText" Foreground="#C6CDDC" FontSize="11" TextWrapping="Wrap" LineHeight="19" Margin="0,9,0,0"/>
                            <Border x:Name="UpdateAvailableBadge" Background="#183B31" CornerRadius="8" Padding="11,8" Margin="0,14,0,0" Visibility="Collapsed"><TextBlock Text="● UPDATE AVAILABLE" Foreground="#6DF2BE" FontWeight="Bold" FontSize="10"/></Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="#0D111B" BorderBrush="#22293C" BorderThickness="0,1,0,0" Padding="14,0"><Grid><TextBlock x:Name="FooterStatus" Text="Ready" Foreground="#8590A8" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="NexaPlay 1.5.0  •  Made by SauceBoyz" HorizontalAlignment="Right" Foreground="#59647B" FontSize="10" VerticalAlignment="Center"/></Grid></Border>
    </Grid>
</Window>
