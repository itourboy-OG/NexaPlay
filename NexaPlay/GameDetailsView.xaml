<UserControl x:Class="NexaPlay.GameDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <Style x:Key="GameActionMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#151B29"/>
            <Setter Property="BorderBrush" Value="#3A4561"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="MinWidth" Value="245"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GameActionMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E7ECF7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemShell" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuItemShell" Property="Background" Value="#29334A"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Height="330" ClipToBounds="True" CacheMode="BitmapCache">
                <Image Source="{Binding DetailHeroUrl}" Stretch="UniformToFill" Opacity="0.82"/>
                <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#18090B12" Offset="0"/><GradientStop Color="#D8090B12" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                <Button Style="{StaticResource GhostButton}" Content="←  BACK TO LIBRARY" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,24" Padding="13,8" Click="Back_Click"/>
                <Grid Margin="34,62,34,28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
                    <Border Width="150" Height="220" CornerRadius="2" BorderBrush="#7260BA" BorderThickness="1" Background="#171C2B" ClipToBounds="True" VerticalAlignment="Bottom">
                        <Grid ClipToBounds="True">
                            <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" Opacity="0.38" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Rectangle Fill="#68111622"/>
                            <Image Source="{Binding CoverUrl}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="18,0,24,4">
                        <WrapPanel Margin="0,0,0,8"><Border Background="#193C44" CornerRadius="3" Padding="8,4" Margin="0,0,7,0"><TextBlock Text="{Binding MultiplayerLabel}" Foreground="#78EEFF" FontWeight="Bold" FontSize="9"/></Border><Border Background="#35255A" CornerRadius="3" Padding="8,4"><TextBlock Text="{Binding Version, StringFormat=VERSION {0}}" Foreground="#D7C8FF" FontWeight="Bold" FontSize="9"/></Border></WrapPanel>
                        <TextBlock Text="{Binding Title}" FontSize="34" FontWeight="Black" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TagLine}" Foreground="#BAC3D7" FontSize="10" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="{Binding Stars}" Foreground="#FFD66B" FontSize="16"/><TextBlock Text="{Binding RatingLabel}" Foreground="#DDE2ED" Margin="9,2,0,0"/><TextBlock Text="{Binding LastUpdatedLabel}" Foreground="#A5AEC2" Margin="18,2,0,0"/></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Content="▶  PLAY" Padding="14,9" Click="Play_Click"/>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button x:Name="FavoriteButton" Style="{StaticResource GhostButton}" Content="♡  FAVORITE" Padding="12,8" Click="Favorite_Click"/>
                            <Button x:Name="MoreButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="•••  MORE" Padding="13,8" Margin="7,0,0,0" Click="More_Click">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource GameActionMenu}" Placement="Bottom" HorizontalOffset="-160">
                                        <MenuItem Style="{StaticResource GameActionMenuItem}" Header="◫  TECHNICAL CITY FPS CHECK  ↗" Click="TechnicalCity_Click"/>
                                        <MenuItem x:Name="ReportMenuItem" Style="{StaticResource GameActionMenuItem}" Header="⚑  REPORT A PROBLEM" Click="Report_Click"/>
                                        <Separator Margin="7,4" Background="#3A4561"/>
                                        <MenuItem x:Name="UninstallMenuItem" Style="{StaticResource GameActionMenuItem}" Header="✕  PERMANENTLY DELETE GAME" Foreground="#FF8E99" Click="Uninstall_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Margin="34,0,34,46">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,28,0">
                    <TextBlock Text="ABOUT THIS GAME" FontSize="17" FontWeight="Black"/>
                    <TextBlock Text="{Binding Description}" Foreground="#C2CADB" FontSize="13" LineHeight="21" TextWrapping="Wrap" Margin="0,11,0,0"/>
                    <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#111622" CornerRadius="4" Padding="14"><StackPanel><TextBlock Text="DEVELOPER" Foreground="#727E99" FontSize="9" FontWeight="Bold"/><TextBlock Text="{Binding Developer}" Margin="0,5,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="#111622" CornerRadius="4" Padding="14" Margin="9,0,0,0"><StackPanel><TextBlock Text="RELEASE DATE" Foreground="#727E99" FontSize="9" FontWeight="Bold"/><TextBlock Text="{Binding ReleaseDate}" Margin="0,5,0,0"/></StackPanel></Border></Grid>

                    <StackPanel x:Name="MediaSection" Margin="0,28,0,0">
                        <Grid><TextBlock Text="MEDIA" FontSize="17" FontWeight="Black"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="TrailerButton" Style="{StaticResource GhostButton}" Content="▶ Trailer" Padding="13,7" Click="Trailer_Click"/><Button x:Name="GameplayButton" Style="{StaticResource GhostButton}" Content="▶ Gameplay" Padding="13,7" Margin="7,0,0,0" Click="Gameplay_Click"/></StackPanel></Grid>
                        <Border x:Name="VideoPanel" Background="#0B0F18" BorderBrush="#343D59" BorderThickness="1" CornerRadius="4" Margin="0,12,0,2" Visibility="Collapsed" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="430"/></Grid.RowDefinitions>
                                <Border Background="#141A28" Padding="13,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="VideoTitle" FontWeight="Bold"/><TextBlock x:Name="VideoStatus" Foreground="#7F8AA1" FontSize="9" Margin="0,3,0,0"/></StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Open in browser" Padding="10,6" Margin="8,0,0,0" Click="OpenVideoInBrowser_Click"/>
                                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Close" Padding="10,6" Margin="7,0,0,0" Click="CloseVideo_Click"/>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1" Background="#05070C">
                                    <Viewbox Stretch="Uniform">
                                        <Grid Width="1280" Height="720" Background="Black">
                                            <MediaElement x:Name="DirectVideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Visibility="Collapsed" MediaFailed="DirectVideoPlayer_MediaFailed" MediaEnded="DirectVideoPlayer_MediaEnded"/>
                                            <wv2:WebView2CompositionControl x:Name="YouTubeWebView" Visibility="Collapsed"/>
                                            <TextBlock x:Name="VideoFallbackText" Text="Finding the actual video…" Foreground="#AAB4C8" FontSize="16" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600" Visibility="Collapsed"/>
                                        </Grid>
                                    </Viewbox>
                                </Grid>
                            </Grid>
                        </Border>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,12,0,0"><ItemsControl x:Name="ScreenshotsList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="280" Height="158" Margin="0,0,10,8" CornerRadius="2" Background="#151A29" BorderBrush="#303851" BorderThickness="1" ClipToBounds="True"><Image Source="{Binding}" Stretch="UniformToFill"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                    </StackPanel>

                    <Border x:Name="GuideSection" Background="#111622" BorderBrush="#293149" BorderThickness="1" CornerRadius="4" Padding="18" Margin="0,26,0,0"><StackPanel><TextBlock Text="INSTALLATION GUIDE" FontSize="15" FontWeight="Black"/><TextBlock Text="{Binding InstallationGuideDisplay}" Foreground="#C0C8D8" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"/></StackPanel></Border>
                    <Border x:Name="NotesSection" Background="#201A15" BorderBrush="#604727" BorderThickness="1" CornerRadius="4" Padding="18" Margin="0,10,0,0"><StackPanel><TextBlock Text="IMPORTANT NOTES" Foreground="#FFD08A" FontSize="15" FontWeight="Black"/><TextBlock Text="{Binding ImportantNotesDisplay}" Foreground="#E4CEAE" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"/></StackPanel></Border>

                    <TextBlock Text="SYSTEM REQUIREMENTS" FontSize="17" FontWeight="Black" Margin="0,28,0,0"/>
                    <Grid x:Name="RequirementsGrid" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#111622" CornerRadius="4" Padding="16"><StackPanel><TextBlock Text="MINIMUM" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="9"/><TextBlock Text="{Binding MinimumRequirementsDisplay}" Foreground="#C2CADB" TextWrapping="Wrap" LineHeight="19" Margin="0,9,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="#111622" CornerRadius="4" Padding="16" Margin="10,0,0,0"><StackPanel><TextBlock Text="RECOMMENDED" Foreground="#BDAEFF" FontWeight="Bold" FontSize="9"/><TextBlock Text="{Binding RecommendedRequirementsDisplay}" Foreground="#C2CADB" TextWrapping="Wrap" LineHeight="19" Margin="0,9,0,0"/></StackPanel></Border></Grid>
                    <Button Style="{StaticResource GhostButton}" Content="LOCAL PC CHECK  —  WINDOWS, RAM &amp; STORAGE" HorizontalAlignment="Left" Margin="0,12,0,0" Click="CanIRun_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border x:Name="DownloadSection" Background="#111622" BorderBrush="#343D59" BorderThickness="1" CornerRadius="5" Padding="20">
                        <StackPanel>
                            <TextBlock Text="DOWNLOAD CENTER" FontSize="18" FontWeight="Black"/>
                            <TextBlock x:Name="DownloadCenterDescription" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,14"/>
                            <Border x:Name="LinkHealthBanner" Background="#171D2B" BorderBrush="#38435E" BorderThickness="1" CornerRadius="3" Padding="11,8" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="LinkHealthDot" Width="8" Height="8" CornerRadius="4" Background="#8894AA" VerticalAlignment="Center"/><TextBlock x:Name="LinkHealthText" Grid.Column="1" Text="Checking download links…" Foreground="#C8D0DF" FontSize="10" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="9,0"/><Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Check again" FontSize="9" Padding="8,5" Click="CheckLinks_Click"/></Grid></Border>
                            <Border Background="#181E2D" CornerRadius="3" Padding="13"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FULL GAME" FontWeight="Bold"/><TextBlock x:Name="GameDownloadInfo" Foreground="#909BB3" FontSize="10" Margin="0,3,0,0"/><TextBlock x:Name="GameLinkStatusText" Foreground="#8894AA" FontSize="9" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><Button x:Name="GameDownloadButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Download" Padding="12,7" Click="DownloadGame_Click"/></Grid></Border>
                            <Border x:Name="UpdatePackageCard" Background="#181E2D" CornerRadius="3" Padding="13" Margin="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LATEST UPDATE" FontWeight="Bold"/><TextBlock x:Name="UpdateDownloadInfo" Foreground="#909BB3" FontSize="10" Margin="0,3,0,0"/><TextBlock x:Name="UpdateLinkStatusText" Foreground="#8894AA" FontSize="9" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><Button x:Name="UpdateDownloadButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="Update" Padding="12,7" Click="DownloadUpdate_Click"/></Grid></Border>
                            <Border x:Name="OnlineFixPackageCard" Background="#181E2D" CornerRadius="3" Padding="13" Margin="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ONLINE FIX" FontWeight="Bold"/><TextBlock x:Name="FixDownloadInfo" Foreground="#909BB3" FontSize="10" Margin="0,3,0,0"/><TextBlock x:Name="FixLinkStatusText" Foreground="#8894AA" FontSize="9" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><Button x:Name="FixDownloadButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="Download" Padding="12,7" Click="DownloadFix_Click"/></Grid></Border>
                            <Border x:Name="CustomPackageCard" Background="#181E2D" CornerRadius="3" Padding="13" Margin="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="CustomPackageTitle" Text="EXTRA PACKAGE" FontWeight="Bold"/><TextBlock x:Name="CustomPackageDownloadInfo" Foreground="#909BB3" FontSize="10" Margin="0,3,0,0"/><TextBlock x:Name="CustomLinkStatusText" Foreground="#8894AA" FontSize="9" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><Button x:Name="CustomPackageDownloadButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="Choose folder" Padding="12,7" Click="DownloadCustom_Click"/></Grid></Border>
                            <Border x:Name="ProgressPanel" Background="#0E131F" CornerRadius="3" Padding="13" Margin="0,12,0,0" Visibility="Collapsed"><StackPanel><TextBlock x:Name="ActivityText" Text="Preparing…" FontSize="11" TextWrapping="Wrap"/><ProgressBar x:Name="DownloadProgress" Margin="0,8,0,0"/><Button Style="{StaticResource GhostButton}" Content="Open Downloads" Padding="9,6" Margin="0,9,0,0" Click="OpenDownloads_Click"/></StackPanel></Border>
                            <Separator Margin="0,15" Background="#30374B"/>
                            <Border x:Name="InstalledStatusCard" Background="#28171D" BorderBrush="#713246" BorderThickness="1" CornerRadius="3" Padding="11,8" Margin="0,0,0,13"><StackPanel Orientation="Horizontal"><Border x:Name="InstalledStatusDot" Width="8" Height="8" CornerRadius="4" Background="#FF748A" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock x:Name="InstalledStatusText" Text="NOT INSTALLED" Foreground="#FF9AAA" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></Border>
                            <TextBlock Text="DOWNLOAD INFO" Foreground="#77839C" FontWeight="Bold" FontSize="9"/>
                            <TextBlock x:Name="DownloadInfoText" Foreground="#C6CDDC" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
