<Window x:Class="NexaPlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NexaPlay"
        Title="NexaPlay" Width="1600" Height="980" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="DownloadArtwork" TargetType="Image">
            <Setter Property="Stretch" Value="UniformToFill"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:DownloadPackageKind.AppUpdate}">
                    <Setter Property="Stretch" Value="Uniform"/>
                    <Setter Property="Margin" Value="8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="46"/><Setter Property="Height" Value="62"/><Setter Property="Foreground" Value="#8792A9"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#1A2030"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Height" Value="49"/><Setter Property="Foreground" Value="#8994AA"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,3,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="11,0,9,0"/><Setter Property="Margin" Value="0,2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#182034"/><Setter Property="Foreground" Value="#F7F9FF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SidebarIcon" TargetType="Border"><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Background" Value="#171E30"/><Setter Property="BorderBrush" Value="#2D3852"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="0,0,12,0"/></Style>
        <Style x:Key="ProfileButton" TargetType="Button"><Setter Property="Height" Value="92"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#15122B"/><Setter Property="BorderBrush" Value="#493A7B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="14"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#201943"/><Setter TargetName="Shell" Property="BorderBrush" Value="#8065D8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.78"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="UpdateBannerButton" TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="MinWidth" Value="190"/><Setter Property="Foreground" Value="#D9FFF0"/><Setter Property="Background" Value="#132B29"/><Setter Property="BorderBrush" Value="#347764"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,0"/><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="7" Height="7" CornerRadius="4" Background="#52E6AD" VerticalAlignment="Center" Margin="0,0,10,0"/><ContentPresenter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#1A3A36"/><Setter TargetName="Shell" Property="BorderBrush" Value="#56B997"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/><Setter TargetName="Shell" Property="Opacity" Value="0.82"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="QuickFilterButton" TargetType="Button">
            <Setter Property="Foreground" Value="#8792A9"/><Setter Property="Background" Value="#101521"/><Setter Property="BorderBrush" Value="#283046"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#1A2030"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="LibraryFilterMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#151B29"/><Setter Property="BorderBrush" Value="#3A4561"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="5"/><Setter Property="MinWidth" Value="220"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ItemsPresenter/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="LibraryFilterMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E7ECF7"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="13,9"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="MenuItemShell" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Icon}" Foreground="#73DFF1" VerticalAlignment="Center"/><ContentPresenter Grid.Column="1" ContentSource="Header"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuItemShell" Property="Background" Value="#29334A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="LauncherPrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#7857F6"/><Setter Property="BorderBrush" Value="#9A83FF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="17,9"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#8B6BFF"/><Setter TargetName="Shell" Property="BorderBrush" Value="#B8AAFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.76"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GameCard" TargetType="Border">
            <Setter Property="Background" Value="#111622"/><Setter Property="BorderBrush" Value="#273047"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="2"/><Setter Property="ClipToBounds" Value="True"/><Setter Property="Cursor" Value="Hand"/><Setter Property="CacheMode" Value="BitmapCache"/><Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="0"/></Setter.Value></Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="-5" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><ColorAnimation Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)" To="#8268F1" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><ColorAnimation Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)" To="#273047" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#30374C" BorderThickness="1" Background="#080B12">
        <Grid>
            <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#090C14" Offset="0"/><GradientStop Color="#080B12" Offset="0.62"/><GradientStop Color="#0D0A18" Offset="1"/></LinearGradientBrush></Grid.Background>
            <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#0A0D15" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
                <Border BorderBrush="#232A3D" BorderThickness="0,0,1,0"><StackPanel Orientation="Horizontal" Margin="18,10"><Image Source="Assets/NexaPlay-512.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel VerticalAlignment="Center" Margin="10,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="NEXA" FontWeight="Black" FontSize="18"/><TextBlock Text="PLAY" Foreground="#45DDF2" FontWeight="Black" FontSize="18"/></StackPanel><TextBlock Text="BUILT BY SAUCEBOYZ" Foreground="#5E6A82" FontWeight="Bold" FontSize="8"/></StackPanel></StackPanel></Border>
                <Grid Grid.Column="1" Margin="22,0,18,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="GAME LIBRARY" Foreground="#DDE3F1" FontSize="11" FontWeight="Bold"/><Border Width="1" Height="16" Background="#30384D" Margin="15,0"/><Border Width="7" Height="7" CornerRadius="4" Background="#52E6AD"/><TextBlock Text="CATALOG LIVE · AUTO REFRESH" Foreground="#6F7B93" FontSize="9" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel><Button x:Name="UpdateBannerButton" Style="{StaticResource UpdateBannerButton}" Content="UPDATE READY" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Click="CheckForUpdates_Click"/></Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource WindowControlButton}" Content="—" Click="Minimize_Click"/><Button Style="{StaticResource WindowControlButton}" Content="□" Click="Maximize_Click"/><Button Style="{StaticResource WindowControlButton}" Content="✕" Click="Close_Click"/></StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border BorderBrush="#303A54" BorderThickness="0,0,1,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#101528"/><GradientStop Color="#0B0F19" Offset="0.48"/><GradientStop Color="#0E0A18" Offset="1"/></LinearGradientBrush></Border.Background>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="14,18,14,0">
                            <Button x:Name="ProfileButton" Style="{StaticResource ProfileButton}" Click="Profile_Click" Margin="0,0,0,24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="50" Height="50" CornerRadius="4" Background="#30265E" BorderBrush="#755DD2" BorderThickness="1" ClipToBounds="True"><Grid><TextBlock x:Name="ProfileInitialsText" Text="P" FontWeight="Black" Foreground="#D9D2FF" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="ProfileAvatarImage" Stretch="UniformToFill" Visibility="Collapsed"/></Grid></Border><StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="ProfileNameText" Text="PLAYER" FontWeight="Black" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="READY UP · GAME ON" Foreground="#8E7EE2" FontSize="8" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="EDIT" Foreground="#68758D" FontSize="8" FontWeight="Bold" VerticalAlignment="Top"/></Grid></Button>
                            <TextBlock Text="PLAY ZONE" Foreground="#65718A" FontWeight="Bold" FontSize="9" Margin="12,0,0,7"/>
                            <Button x:Name="LibraryNav" Style="{StaticResource SidebarButton}" Click="Library_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource SidebarIcon}"><TextBlock Text="◆" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#65E3F4"/></Border><TextBlock Grid.Column="1" Text="Discover" VerticalAlignment="Center"/></Grid></Button>
                            <Button x:Name="InstalledNav" Style="{StaticResource SidebarButton}" Click="Installed_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource SidebarIcon}"><TextBlock Text="▶" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#A998FF"/></Border><TextBlock Grid.Column="1" Text="Installed" VerticalAlignment="Center"/></Grid></Button>
                            <Button x:Name="FavoritesNav" Style="{StaticResource SidebarButton}" Click="Favorites_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource SidebarIcon}"><TextBlock Text="♥" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF78B5"/></Border><TextBlock Grid.Column="1" Text="Favorites" VerticalAlignment="Center"/></Grid></Button>
                            <TextBlock Text="MANAGE" Foreground="#59657C" FontWeight="Bold" FontSize="9" Margin="18,24,0,7"/>
                            <Button x:Name="DownloadsNav" Style="{StaticResource SidebarButton}" Click="Downloads_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Style="{StaticResource SidebarIcon}"><TextBlock Text="↓" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#52E6AD" FontSize="16"/></Border><TextBlock Grid.Column="1" Text="Downloads" VerticalAlignment="Center"/><Border x:Name="DownloadCountBadge" Grid.Column="2" Background="#7857F6" CornerRadius="8" Padding="6,2" Visibility="Collapsed"><TextBlock x:Name="DownloadCountText" Text="0" FontSize="9" FontWeight="Bold"/></Border></Grid></Button>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="16,0,16,18"><Button x:Name="SettingsNav" Style="{StaticResource SidebarButton}" Content="⚙     Settings" Click="Settings_Click"/><Border Background="#0F1620" BorderBrush="#263149" BorderThickness="1" CornerRadius="2" Padding="12" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="8" Height="8" CornerRadius="4" Background="#52E6AD" VerticalAlignment="Top" Margin="0,3,9,0"/><StackPanel Grid.Column="1"><TextBlock Text="SYSTEM READY" Foreground="#9AE9CA" FontSize="9" FontWeight="Bold"/><TextBlock Text="Downloads continue in the background while you browse." Foreground="#68758D" FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Grid></Border></StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                    <Grid x:Name="PageHost" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Grid x:Name="LibraryPage" MaxWidth="2048" HorizontalAlignment="Center">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="32,25,32,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="DISCOVER" FontSize="29" FontWeight="Black"/><TextBlock x:Name="PageSubtitle" Text="Your next game starts here" Foreground="#7F8AA1" FontSize="12" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Height="44" Background="#101521" BorderBrush="#2B344A" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⌕" FontSize="22" Foreground="#6D7890" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/><TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" Padding="0" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Search games, tags, or developer"/></Grid></Border></Grid>
                            <Grid Grid.Row="1" Margin="32,0,20,0">
                                <ScrollViewer x:Name="LibraryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <Border x:Name="FeaturedPanel" Height="286" CornerRadius="2" Background="#151A28" BorderBrush="#303A56" BorderThickness="1" Margin="0,0,12,18" ClipToBounds="True" CacheMode="BitmapCache">
                                            <Grid>
                                                <Image x:Name="FeaturedHero" Stretch="UniformToFill" Opacity="0.6" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#FF090C14" Offset="0"/><GradientStop Color="#EA090C14" Offset="0.46"/><GradientStop Color="#82090C14" Offset="0.72"/><GradientStop Color="#30090C14" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                                <Rectangle VerticalAlignment="Bottom" Height="90"><Rectangle.Fill><LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0"><GradientStop Color="#E5090C14" Offset="0"/><GradientStop Color="#00090C14" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                                <Border Width="4" Background="#7C5CFA" HorizontalAlignment="Left"/>
                                                <StackPanel Width="610" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="38,0,0,0"><StackPanel Orientation="Horizontal"><Border Background="#33275E" BorderBrush="#6F54D6" BorderThickness="1" CornerRadius="2" Padding="8,4"><TextBlock Text="FEATURED DROP" Foreground="#D0C5FF" FontWeight="Bold" FontSize="9"/></Border><TextBlock Text="{Binding MultiplayerLabel}" Foreground="#61E1F2" FontSize="9" FontWeight="Bold" Margin="12,5,0,0"/></StackPanel><TextBlock x:Name="FeaturedTitle" Text="NexaPlay" FontSize="38" FontWeight="Black" Margin="0,13,0,5" TextWrapping="Wrap"/><TextBlock Text="{Binding Developer}" Foreground="#8E9AB1" FontSize="10" FontWeight="SemiBold" Margin="1,0,0,9"/><TextBlock x:Name="FeaturedDescription" Foreground="#C6CDDC" FontSize="13" LineHeight="19" TextWrapping="Wrap" MaxHeight="60"/><Button x:Name="FeaturedAction" Style="{StaticResource LauncherPrimaryButton}" Content="VIEW GAME" HorizontalAlignment="Left" Margin="0,17,0,0" Click="FeaturedAction_Click"/></StackPanel>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,20" Background="#C20D111B" BorderBrush="#35405A" BorderThickness="1" CornerRadius="2" Padding="13,10"><StackPanel><TextBlock Text="{Binding Stars}" Foreground="#FFCE55" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock Text="{Binding RatingLabel}" Foreground="#D6DBE7" FontSize="9" HorizontalAlignment="Right" Margin="0,3,0,0"/><TextBlock Text="{Binding LastUpdatedLabel}" Foreground="#7D89A0" FontSize="9" HorizontalAlignment="Right" Margin="0,7,0,0"/></StackPanel></Border>
                                            </Grid>
                                        </Border>
                                        <Grid Margin="0,0,12,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="FilterMenuButton" Style="{StaticResource QuickFilterButton}" Content="FILTER: ALL GAMES  ▾" HorizontalAlignment="Left" Padding="16,9" Click="FilterMenu_Click"><Button.ContextMenu><ContextMenu Style="{StaticResource LibraryFilterMenu}" Placement="Bottom"><MenuItem Style="{StaticResource LibraryFilterMenuItem}" Header="All games" Icon="◆" Tag="ALL" Click="QuickFilter_Click"/><MenuItem Style="{StaticResource LibraryFilterMenuItem}" Header="Single-player" Icon="●" Tag="SINGLEPLAYER" Click="QuickFilter_Click"/><MenuItem Style="{StaticResource LibraryFilterMenuItem}" Header="Multiplayer" Icon="●" Tag="MULTIPLAYER" Click="QuickFilter_Click"/><MenuItem Style="{StaticResource LibraryFilterMenuItem}" Header="Co-op" Icon="●" Tag="COOP" Click="QuickFilter_Click"/><Separator Margin="7,4" Background="#3A4561"/><MenuItem Style="{StaticResource LibraryFilterMenuItem}" Header="Recently updated" Icon="↻" Tag="RECENT" Click="QuickFilter_Click"/><MenuItem Style="{StaticResource LibraryFilterMenuItem}" Header="Updates available" Icon="↓" Tag="UPDATES" Click="QuickFilter_Click"/></ContextMenu></Button.ContextMenu></Button><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="LibraryStatsText" Foreground="#7D89A0" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Width="1" Height="14" Background="#333C52" Margin="12,0"/><TextBlock x:Name="GameCount" Foreground="#AEB7CA" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></Grid>
                                        <ItemsControl x:Name="GamesList">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Border Style="{StaticResource GameCard}" Width="244" Height="476" Margin="0,0,15,20" Tag="{Binding}" MouseLeftButtonUp="GameCard_Click">
                                                    <Grid><Grid.RowDefinitions><RowDefinition Height="344"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Background="#090C14" ClipToBounds="True"><Image Source="Assets/NexaPlay-512.png" Width="82" Height="82" Opacity="0.13" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding CoverUrl}" Stretch="UniformToFill" Opacity="0.34" RenderOptions.BitmapScalingMode="HighQuality"/><Rectangle Fill="#6B090C14"/><Image Source="{Binding CoverUrl}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><Rectangle VerticalAlignment="Bottom" Height="60"><Rectangle.Fill><LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0"><GradientStop Color="#F0090C14" Offset="0"/><GradientStop Color="#00090C14" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Border Height="3" VerticalAlignment="Top" Background="#7055E8"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"><Border Background="#E0184E3E" BorderBrush="#48B98E" BorderThickness="1" CornerRadius="2" Padding="7,3" Margin="0,0,5,0" Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="UPDATE" Foreground="#7BF1BF" FontSize="8" FontWeight="Bold"/></Border><Border Background="#E03D2455" BorderBrush="#9A527E" BorderThickness="1" CornerRadius="2" Padding="7,3" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="♥" Foreground="#FF8DC0" FontSize="9"/></Border></StackPanel><Grid VerticalAlignment="Bottom" Margin="11,0,11,9"><TextBlock Text="{Binding MultiplayerLabel}" Foreground="#70E2F2" FontSize="8" FontWeight="Bold"/><TextBlock Text="{Binding Stars}" Foreground="#F6C956" FontSize="10" HorizontalAlignment="Right"/></Grid><Border Background="#E20A0D16" VerticalAlignment="Bottom" Padding="10,7" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"><StackPanel><TextBlock Text="{Binding Activity}" FontSize="10" TextTrimming="CharacterEllipsis"/><ProgressBar Value="{Binding Progress}" Margin="0,5,0,0"/></StackPanel></Border></Grid><Grid Grid.Row="1" Margin="13,11,13,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="1" Text="{Binding Developer}" Foreground="#737F97" FontSize="9" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Row="2" Margin="0,8,0,6"><TextBlock Text="{Binding TagLine}" Foreground="#949FB5" FontSize="8" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding LastUpdatedLabel}" Foreground="#68748C" FontSize="9" Margin="0,6,0,0"/></StackPanel><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Style="{StaticResource LauncherPrimaryButton}" Padding="13,7" Content="{Binding ActionLabel}" Tag="{Binding}" Click="GameAction_Click"/><Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="10,7" Content="✕" Margin="7,0,0,0" ToolTip="Cancel download" Tag="{Binding}" Click="Cancel_Click" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/></Grid></Grid></Grid>
                                                </Border>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid x:Name="PaginationBar" Margin="0,4,12,28">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="PageSummaryText" Foreground="#7D89A0" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="PreviousPageButton" Style="{StaticResource QuickFilterButton}" Content="←  PREVIOUS" Padding="13,8" Click="PreviousPage_Click"/><StackPanel x:Name="PageButtonsPanel" Orientation="Horizontal"/><Button x:Name="NextPageButton" Style="{StaticResource QuickFilterButton}" Content="NEXT  →" Padding="13,8" Margin="0" Click="NextPage_Click"/></StackPanel>
                                            <TextBlock x:Name="PageNumberText" Grid.Column="2" Foreground="#AEB7CA" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Border x:Name="EmptyState" Visibility="Collapsed" Margin="0,22,12,40" Background="#101521" BorderBrush="#293149" BorderThickness="1" CornerRadius="2" Padding="40"><StackPanel HorizontalAlignment="Center"><Image Source="Assets/NexaPlay-512.png" Width="82" Height="82" Opacity="0.75"/><TextBlock Text="NO GAMES FOUND" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" Margin="0,15,0,4"/><TextBlock Text="Try another search, filter, or sync the catalog." Foreground="#7B879E" HorizontalAlignment="Center"/></StackPanel></Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <local:GameDetailsView x:Name="DetailsPage" MaxWidth="2048" HorizontalAlignment="Center" Visibility="Collapsed"/>
                        <Grid x:Name="DownloadsPage" MaxWidth="2048" HorizontalAlignment="Center" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="300"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="32,24,32,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DOWNLOADS" FontSize="29" FontWeight="Black"/><TextBlock Text="Live download activity, queue, and complete transfer history" Foreground="#7F8AA1" FontSize="12" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#101724" BorderBrush="#28344A" BorderThickness="1" Padding="18,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="NETWORK" Foreground="#71809B" FontSize="8" FontWeight="Bold"/><TextBlock x:Name="NetworkSpeedText" Text="0 B/s" Foreground="#46D9F1" FontSize="14" FontWeight="Black" Margin="0,3,0,0"/></StackPanel></Border><Border Background="#101724" BorderBrush="#28344A" BorderThickness="1" Padding="18,10"><StackPanel><TextBlock Text="PEAK" Foreground="#71809B" FontSize="8" FontWeight="Bold"/><TextBlock x:Name="PeakSpeedText" Text="0 B/s" Foreground="#8A72FF" FontSize="14" FontWeight="Black" Margin="0,3,0,0"/></StackPanel></Border></StackPanel></Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="32,0,20,20"><StackPanel><Border x:Name="DownloadsEmpty" Background="#101521" BorderBrush="#293149" BorderThickness="1" CornerRadius="2" Padding="50"><StackPanel HorizontalAlignment="Center"><TextBlock Text="↓" FontSize="45" Foreground="#7559EC" HorizontalAlignment="Center"/><TextBlock Text="NOTHING DOWNLOADING" FontSize="18" FontWeight="Black" Margin="0,12,0,4"/><TextBlock Text="Start a game download and all live details will appear here." Foreground="#7F8AA1"/></StackPanel></Border><ItemsControl x:Name="DownloadsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#111622" BorderBrush="#30384F" BorderThickness="1" CornerRadius="2" Padding="16" Margin="0,0,10,12" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="410"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="70" Height="92" CornerRadius="2" ClipToBounds="True" Background="#202638"><Image Source="{Binding CoverUrl}" Style="{StaticResource DownloadArtwork}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,16,0"><TextBlock Text="{Binding GameTitle}" FontSize="16" FontWeight="Bold"/><TextBlock Text="{Binding PackageLabel}" Foreground="#8F7AFF" FontSize="9" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="{Binding Phase}" Foreground="#AAB4C8" FontSize="11" Margin="0,7,0,0"/><TextBlock Text="{Binding Status}" Foreground="#737F98" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Grid Grid.Column="2" VerticalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ProgressBar Value="{Binding Percent}" Height="7"/><Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SPEED" Foreground="#66728B" FontSize="8" FontWeight="Bold"/><TextBlock Text="{Binding SpeedLabel}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="REMAINING" Foreground="#66728B" FontSize="8" FontWeight="Bold"/><TextBlock Text="{Binding EtaLabel}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="DONE AT" Foreground="#66728B" FontSize="8" FontWeight="Bold"/><TextBlock Text="{Binding FinishLabel}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="PROGRESS" Foreground="#66728B" FontSize="8" FontWeight="Bold"/><TextBlock Text="{Binding Percent, StringFormat={}{0:0}%}" Margin="0,3,0,0"/></StackPanel></Grid><TextBlock Grid.Row="2" Text="{Binding TransferredLabel}" Foreground="#7F8AA1" FontSize="9" Margin="0,7,0,0"/></Grid><Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="Cancel" Padding="11,7" Margin="16,0,0,0" Tag="{Binding Key}" Click="CancelDownloadItem_Click" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="32,0,20,20">
                                <StackPanel Margin="0,0,10,0">
                                    <Grid Margin="0,4,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="QueueCountText" Text="UP NEXT (0)" FontSize="16" FontWeight="Black"/><Border Grid.Column="1" Height="1" Background="#30384B" Margin="14,10,0,0"/></Grid>
                                    <Border x:Name="QueueEmpty" Background="#0E131E" BorderBrush="#252E42" BorderThickness="1" Padding="18" Margin="0,0,0,12"><TextBlock Text="There are no downloads in the queue" Foreground="#737F94" FontSize="11"/></Border>
                                    <ItemsControl x:Name="QueuedDownloadsList">
                                        <ItemsControl.ItemTemplate><DataTemplate><Border Background="#151A27" BorderBrush="#30384F" BorderThickness="1" Padding="12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="48" Height="62" Background="#202638" ClipToBounds="True"><Image Source="{Binding CoverUrl}" Style="{StaticResource DownloadArtwork}"/></Border><StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center"><TextBlock Text="{Binding GameTitle}" FontSize="13" FontWeight="Bold"/><TextBlock Text="{Binding PackageLabel}" Foreground="#8F7AFF" FontSize="8" FontWeight="Bold" Margin="0,3,0,0"/><TextBlock Text="WAITING FOR CURRENT DOWNLOAD" Foreground="#7C899F" FontSize="9" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Cancel" Padding="12,7" Tag="{Binding Key}" Click="CancelDownloadItem_Click" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,18,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="HistoryCountText" Text="DOWNLOAD HISTORY (0)" FontSize="16" FontWeight="Black"/><Border Grid.Column="1" Height="1" Background="#30384B" Margin="14,10"/><Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Clear history" Padding="12,7" Click="ClearHistory_Click"/></Grid>
                                    <Border x:Name="HistoryEmpty" Background="#0E131E" BorderBrush="#252E42" BorderThickness="1" Padding="18"><TextBlock Text="Completed, canceled, and failed downloads will appear here" Foreground="#737F94" FontSize="11"/></Border>
                                    <ItemsControl x:Name="DownloadHistoryList">
                                        <ItemsControl.ItemTemplate><DataTemplate><Border Background="#101521" BorderBrush="#283147" BorderThickness="1" Padding="12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><Border Width="48" Height="62" Background="#202638" ClipToBounds="True"><Image Source="{Binding CoverUrl}" Style="{StaticResource DownloadArtwork}"/></Border><StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center"><TextBlock Text="{Binding GameTitle}" FontSize="13" FontWeight="Bold"/><TextBlock Text="{Binding PackageLabel}" Foreground="#8F7AFF" FontSize="8" FontWeight="Bold" Margin="0,3,0,0"/><TextBlock Text="{Binding Status}" Foreground="#8793A9" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Outcome}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="10"/><TextBlock Text="{Binding CompletedLabel}" HorizontalAlignment="Right" Foreground="#768299" FontSize="9" Margin="0,4,0,0"/><TextBlock Text="{Binding SizeLabel}" HorizontalAlignment="Right" Foreground="#5FDDB0" FontSize="9" Margin="0,4,0,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                    <Border Grid.Row="1" Background="#0B0F18" BorderBrush="#222A3C" BorderThickness="0,1,0,0" Padding="14,0"><Grid><TextBlock x:Name="StatusText" Text="Ready" Foreground="#748096" FontSize="9" VerticalAlignment="Center"/><TextBlock Text="NexaPlay 1.11.2  ·  Made by SauceBoyz" HorizontalAlignment="Right" Foreground="#4F5B71" FontSize="9" VerticalAlignment="Center"/></Grid></Border>
                </Grid>
            </Grid>

            <Border x:Name="ToastPanel" Grid.RowSpan="2" Panel.ZIndex="90" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,76,28,0" Width="390" Background="#F0192030" BorderBrush="#4DDDB1" BorderThickness="1" CornerRadius="4" Padding="16">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="8" Height="8" CornerRadius="4" Background="#52E6AD" VerticalAlignment="Top" Margin="0,4,12,0"/><StackPanel Grid.Column="1"><TextBlock x:Name="ToastTitle" FontWeight="Black" FontSize="12"/><TextBlock x:Name="ToastMessage" Foreground="#AEB8CB" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Grid>
            </Border>

            <Grid x:Name="ModalOverlay" Grid.RowSpan="2" Panel.ZIndex="100" Visibility="Collapsed" Background="#D9070A11">
                <Border Width="560" MaxHeight="640" Background="#121827" BorderBrush="#4A5875" BorderThickness="1" CornerRadius="5" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="ModalTitle" FontSize="22" FontWeight="Black" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ModalMessage" Foreground="#AAB5CA" FontSize="12" TextWrapping="Wrap" Margin="0,11,0,0" LineHeight="19"/>
                        <TextBox x:Name="ModalInput" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0" Padding="12" Background="#0B101B" BorderBrush="#34415C" Foreground="#F4F6FC" CaretBrush="White"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button x:Name="ModalSecondaryButton" Style="{StaticResource GhostButton}" Content="Cancel" Padding="18,10" Margin="0,0,9,0" Click="ModalSecondary_Click"/>
                            <Button x:Name="ModalPrimaryButton" Style="{StaticResource LauncherPrimaryButton}" Content="OK" Padding="22,10" Click="ModalPrimary_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
