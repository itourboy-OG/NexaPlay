<Window x:Class="NexaPlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NexaPlay"
        Title="NexaPlay" Width="1460" Height="920" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#AAB3C7"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="18,13"/><Setter Property="Margin" Value="0,2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#161C2A"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GameCard" TargetType="Border">
            <Setter Property="Background" Value="#121725"/><Setter Property="BorderBrush" Value="#293149"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="2"/><Setter Property="ClipToBounds" Value="True"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/><Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.018" Duration="0:0:0.13"/><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.018" Duration="0:0:0.13"/><ColorAnimation Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)" To="#7864D8" Duration="0:0:0.13"/></Storyboard></BeginStoryboard></EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.13"/><DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.13"/><ColorAnimation Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)" To="#293149" Duration="0:0:0.13"/></Storyboard></BeginStoryboard></EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#30364A" BorderThickness="1" Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#0B0E16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="*"/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="18,8"><Image Source="Assets/NexaPlay-512.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel VerticalAlignment="Center" Margin="10,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="NEXA" FontWeight="Black" FontSize="17"/><TextBlock Text="PLAY" Foreground="{StaticResource CyanBrush}" FontWeight="Black" FontSize="17"/></StackPanel><TextBlock Text="BY SAUCEBOYZ" Foreground="#646F88" FontWeight="Bold" FontSize="8"/></StackPanel></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Width="7" Height="7" CornerRadius="4" Background="#58E6B0"/><TextBlock Text="PLAYER CLIENT" Foreground="#77829B" FontSize="10" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource NavButton}" Width="46" Content="—" HorizontalContentAlignment="Center" Click="Minimize_Click"/><Button Style="{StaticResource NavButton}" Width="46" Content="□" HorizontalContentAlignment="Center" Click="Maximize_Click"/><Button Style="{StaticResource NavButton}" Width="46" Content="✕" HorizontalContentAlignment="Center" Click="Close_Click"/></StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#0C1019" BorderBrush="#202638" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="14,22,14,0">
                            <Border Background="#131928" BorderBrush="#29324A" BorderThickness="1" CornerRadius="3" Padding="13" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" Background="#2B2450" CornerRadius="3"><TextBlock Text="S" FontWeight="Black" Foreground="#C7BAFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="SAUCEBOYZ LIBRARY" FontWeight="Bold" FontSize="10"/><TextBlock Text="Games ready to discover" Foreground="#78839A" FontSize="9" Margin="0,3,0,0"/></StackPanel></Grid></Border>
                            <TextBlock Text="LIBRARY" Foreground="#5F6B83" FontWeight="Bold" FontSize="9" Margin="16,0,0,7"/>
                            <Button x:Name="LibraryNav" Style="{StaticResource SidebarButton}" Content="⌂     Discover" Click="Library_Click"/>
                            <Button x:Name="InstalledNav" Style="{StaticResource SidebarButton}" Content="▶     Installed" Click="Installed_Click"/>
                            <Button x:Name="FavoritesNav" Style="{StaticResource SidebarButton}" Content="♥     Favorites" Click="Favorites_Click"/>
                            <TextBlock Text="ACTIVITY" Foreground="#5F6B83" FontWeight="Bold" FontSize="9" Margin="16,23,0,7"/>
                            <Button x:Name="DownloadsNav" Style="{StaticResource SidebarButton}" Click="Downloads_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="↓     Downloads"/><Border x:Name="DownloadCountBadge" Grid.Column="1" Background="#6D51E8" CornerRadius="8" Padding="6,2" Visibility="Collapsed"><TextBlock x:Name="DownloadCountText" Text="0" FontSize="9" FontWeight="Bold"/></Border></Grid></Button>
                            <Button x:Name="SyncNav" Style="{StaticResource SidebarButton}" Content="↻     Sync library" Click="Sync_Click"/>
                            <Button x:Name="UpdateNav" Style="{StaticResource SidebarButton}" Content="↑     Check for updates" Click="CheckForUpdates_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="14,0,14,18"><Button x:Name="SettingsNav" Style="{StaticResource SidebarButton}" Content="⚙     Settings" Click="Settings_Click"/><Border Background="#101622" BorderBrush="#283148" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,12,0,0"><StackPanel><StackPanel Orientation="Horizontal"><Border Width="7" Height="7" CornerRadius="4" Background="#55E4AF" VerticalAlignment="Center"/><TextBlock Text="READY TO PLAY" Foreground="#9DECCF" FontSize="9" FontWeight="Bold" Margin="7,0,0,0"/></StackPanel><TextBlock Text="Downloads continue while you browse." Foreground="#707C94" FontSize="9" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border></StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                    <Grid x:Name="PageHost" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Grid x:Name="LibraryPage">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="30,24,30,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="DISCOVER" FontSize="27" FontWeight="Black"/><TextBlock x:Name="PageSubtitle" Text="Find your next game" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="#111623" BorderBrush="#2A3146" BorderThickness="1" CornerRadius="3" Padding="12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⌕" FontSize="21" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,9,2"/><TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" TextChanged="SearchBox_TextChanged" ToolTip="Search games"/></Grid></Border></Grid>
                            <Grid Grid.Row="1" Margin="30,0,20,0"><ScrollViewer x:Name="LibraryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                                <Border x:Name="FeaturedPanel" Height="248" CornerRadius="3" Background="#161B2A" BorderBrush="#303957" BorderThickness="1" Margin="0,0,10,23" ClipToBounds="True" CacheMode="BitmapCache"><Grid><Image x:Name="FeaturedHero" Stretch="UniformToFill" Opacity="0.44"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#FA0A0D16" Offset="0"/><GradientStop Color="#C20A0D16" Offset="0.55"/><GradientStop Color="#380A0D16" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><StackPanel Width="570" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="34,0"><Border Background="#31295B" CornerRadius="3" Padding="7,4" HorizontalAlignment="Left"><TextBlock Text="FEATURED" Foreground="#C8B9FF" FontWeight="Bold" FontSize="9"/></Border><TextBlock x:Name="FeaturedTitle" Text="NexaPlay" FontSize="32" FontWeight="Black" Margin="0,12,0,5" TextWrapping="Wrap"/><TextBlock x:Name="FeaturedDescription" Foreground="#C2C9DA" FontSize="13" TextWrapping="Wrap" MaxHeight="58"/><Button x:Name="FeaturedAction" Style="{StaticResource PrimaryButton}" Content="View game" HorizontalAlignment="Left" Margin="0,16,0,0" Click="FeaturedAction_Click"/></StackPanel></Grid></Border>
                                <Grid Margin="0,0,10,13"><TextBlock Text="ALL GAMES" FontSize="14" FontWeight="Bold"/><TextBlock x:Name="GameCount" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10"/></Grid>
                                <ItemsControl x:Name="GamesList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Style="{StaticResource GameCard}" Width="244" Height="365" Margin="0,0,15,18" Tag="{Binding}" MouseLeftButtonUp="GameCard_Click"><Grid><Grid.RowDefinitions><RowDefinition Height="226"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Background="#1C2232"><Image Source="{Binding CoverUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"><Border Background="#D921614D" CornerRadius="2" Padding="6,3" Margin="0,0,4,0" Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="UPDATE" Foreground="#77F5C0" FontSize="8" FontWeight="Bold"/></Border><Border Background="#D93D2455" CornerRadius="2" Padding="6,3" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="♥" Foreground="#FF83BD"/></Border></StackPanel><Border Background="#D20A0D16" VerticalAlignment="Bottom" Padding="9,6" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"><StackPanel><TextBlock Text="{Binding Activity}" FontSize="10" TextTrimming="CharacterEllipsis"/><ProgressBar Value="{Binding Progress}" Margin="0,5,0,0"/></StackPanel></Border></Grid><Grid Grid.Row="1" Margin="13,11"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="1" Text="{Binding TagLine}" Foreground="#8D98B2" FontSize="8" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="2" Text="{Binding Description}" Foreground="#AEB6C9" FontSize="10" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,7,0,3"/><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Style="{StaticResource PrimaryButton}" Padding="13,7" Content="{Binding ActionLabel}" Tag="{Binding}" Click="GameAction_Click"/><Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="10,7" Content="✕" Margin="7,0,0,0" ToolTip="Cancel download" Tag="{Binding}" Click="Cancel_Click" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/></Grid></Grid></Grid></Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <Border x:Name="EmptyState" Visibility="Collapsed" Margin="0,22,10,40" Background="#101521" BorderBrush="#293149" BorderThickness="1" CornerRadius="3" Padding="40"><StackPanel HorizontalAlignment="Center"><Image Source="Assets/NexaPlay-512.png" Width="90" Height="90" Opacity="0.8"/><TextBlock Text="No games found" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,4"/><TextBlock Text="Try another search or sync the library." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/></StackPanel></Border>
                            </StackPanel></ScrollViewer></Grid>
                        </Grid>

                        <local:GameDetailsView x:Name="DetailsPage" Visibility="Collapsed"/>

                        <Grid x:Name="DownloadsPage" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="30,24,30,18"><StackPanel><TextBlock Text="DOWNLOADS" FontSize="27" FontWeight="Black"/><TextBlock Text="Live speed, remaining time, finish time, and install progress" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel><Button Style="{StaticResource GhostButton}" Content="Clear finished" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClearFinished_Click"/></Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="30,0,20,20"><StackPanel><Border x:Name="DownloadsEmpty" Background="#101521" BorderBrush="#293149" BorderThickness="1" CornerRadius="3" Padding="50"><StackPanel HorizontalAlignment="Center"><TextBlock Text="↓" FontSize="45" Foreground="#6553C8" HorizontalAlignment="Center"/><TextBlock Text="Nothing downloading yet" FontSize="19" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock Text="Start a game download and all live details will appear here." Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
                                <ItemsControl x:Name="DownloadsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#111622" BorderBrush="#30384F" BorderThickness="1" CornerRadius="3" Padding="16" Margin="0,0,10,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="410"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="70" Height="92" CornerRadius="2" ClipToBounds="True" Background="#202638"><Image Source="{Binding CoverUrl}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,16,0"><TextBlock Text="{Binding GameTitle}" FontSize="16" FontWeight="Bold"/><TextBlock Text="{Binding PackageLabel}" Foreground="#8F7AFF" FontSize="9" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="{Binding Phase}" Foreground="#AAB4C8" FontSize="11" Margin="0,7,0,0"/><TextBlock Text="{Binding Status}" Foreground="#737F98" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Grid Grid.Column="2" VerticalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ProgressBar Value="{Binding Percent}" Height="7"/><Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SPEED" Foreground="#66728B" FontSize="8" FontWeight="Bold"/><TextBlock Text="{Binding SpeedLabel}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="REMAINING" Foreground="#66728B" FontSize="8" FontWeight="Bold"/><TextBlock Text="{Binding EtaLabel}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="DONE AT" Foreground="#66728B" FontSize="8" FontWeight="Bold"/><TextBlock Text="{Binding FinishLabel}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="PROGRESS" Foreground="#66728B" FontSize="8" FontWeight="Bold"/><TextBlock Text="{Binding Percent, StringFormat={}{0:0}%}" Margin="0,3,0,0"/></StackPanel></Grid><TextBlock Grid.Row="2" Text="{Binding TransferredLabel}" Foreground="#7F8AA1" FontSize="9" Margin="0,7,0,0"/></Grid><Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="Cancel" Padding="11,7" Margin="16,0,0,0" Tag="{Binding Key}" Click="CancelDownloadItem_Click" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel></ScrollViewer>
                        </Grid>
                    </Grid>
                    <Border Grid.Row="1" Background="#0D111B" BorderBrush="#22293C" BorderThickness="0,1,0,0" Padding="14,0"><Grid><TextBlock x:Name="StatusText" Text="Ready" Foreground="#8590A8" FontSize="10" VerticalAlignment="Center"/><TextBlock Text="NexaPlay 1.6.0  •  Made by SauceBoyz" HorizontalAlignment="Right" Foreground="#59647B" FontSize="9" VerticalAlignment="Center"/></Grid></Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
