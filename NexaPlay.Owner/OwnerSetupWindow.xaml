<Window x:Class="NexaPlay.Owner.OwnerSetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NexaPlay Owner Connection" Width="620" Height="410" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#090B12" Foreground="#F6F7FB">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="OPTIONAL ONLINE PUBLISHING" FontSize="25" FontWeight="Black"/><TextBlock Text="You do not need this for Owner Studio. Use it only after a NexaPlay Community server has been deployed for shared ratings and instant catalog publishing." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Row="1" Margin="0,25,0,0"><TextBlock Text="COMMUNITY SERVER URL" Foreground="#7B87A1" FontSize="10" FontWeight="Bold"/><TextBox x:Name="UrlBox" Margin="0,7,0,18"/><TextBlock Text="PRIVATE OWNER KEY" Foreground="#7B87A1" FontSize="10" FontWeight="Bold"/><PasswordBox x:Name="KeyBox" Margin="0,7,0,0" Background="#101522" Foreground="White" BorderBrush="{StaticResource StrokeBrush}" Padding="12,9"/><TextBlock Text="This key is created when the server is deployed. Do not invent or share one here. It never goes inside the player installer." Foreground="#758199" TextWrapping="Wrap" FontSize="10" Margin="0,9,0,0"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource GhostButton}" Content="Keep using local mode" Click="Cancel_Click"/><Button Style="{StaticResource PrimaryButton}" Content="Save owner connection" Margin="9,0,0,0" Click="Save_Click"/></StackPanel></Grid>
</Window>
