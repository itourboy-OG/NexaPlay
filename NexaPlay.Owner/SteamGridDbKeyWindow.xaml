<Window x:Class="NexaPlay.Owner.SteamGridDbKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SteamGridDB Key — NexaPlay Owner Studio" Width="660" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="STEAMGRIDDB ARTWORK KEY" FontSize="25" FontWeight="Black"/>
            <TextBlock Text="Only Owner Studio needs this. Friends never enter a key—NexaPlay publishes the selected artwork URLs in your catalog." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,26,0,0">
            <TextBlock Text="YOUR PRIVATE API KEY" Foreground="#7B87A1" FontSize="10" FontWeight="Bold"/>
            <PasswordBox x:Name="KeyBox" Margin="0,8,0,0" Background="#101522" Foreground="White" BorderBrush="{StaticResource StrokeBrush}" Padding="12,10" FontSize="14"/>
            <TextBlock x:Name="KeyStatusText" Foreground="#75E8BF" FontSize="11" Margin="0,9,0,0"/>
            <Border Background="#101622" BorderBrush="#29324A" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,22,0,0">
                <StackPanel>
                    <TextBlock Text="PRIVATE BY DESIGN" Foreground="#AFA1FF" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="The key is encrypted with Windows Data Protection for this Windows account. It is never saved in GitHub, the public catalog, the Player installer, or artwork URLs." Foreground="#A8B2C7" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
            <Button Style="{StaticResource GhostButton}" Content="Open SteamGridDB API key page" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OpenApiPage_Click"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Button Style="{StaticResource GhostButton}" Content="Remove saved key" HorizontalAlignment="Left" Click="Remove_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Save encrypted key" Margin="9,0,0,0" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
